<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de backup y transferencia para API >= 31. Mismo criterio que
  backup_rules.xml: los tokens de sesión no salen del dispositivo.

  En device-transfer también se excluyen: aunque el traspaso es directo entre
  dos equipos del mismo dueño, la sesión se vuelve a abrir con login y no hay
  razón para mover credenciales.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session_tokens.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session_tokens.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
